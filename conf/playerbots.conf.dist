####################################################################################################

###################################
#                                 #
# RAIDS                           #
#                                 #
###################################

####################################################################################################
#
#

# Enable buffs in ICC to make Heroic easier and more casual.
# 30% more damage, 40% damage reduction (tank bots), increased all resistances, reduced threat for
# non-tank bots, increased threat for tank bots.
# Buffs will be applied on LDW, PP, Sindragosa and Lich King.
# Default: 1 (enabled)
AiPlayerbot.EnableICCBuffs = 1

#
#
####################################################################################################

###################################
#                                 #
# PLAYERBOTS SYSTEM SETTINGS      #
#                                 #
###################################

####################################################################################################
# DATABASE & CONNECTIONS
#
#    PlayerbotsDatabaseInfo
#        Description: Database connection settings for the playerbots server.
#        Example:     "hostname;port;username;password;database"
#                     ".;somenumber;username;password;database" - (Use named pipes on Windows
#                                                                 "enable-named-pipe" to [mysqld]
#                                                                 section my.ini)
#                     ".;/path/to/unix_socket;username;password;database" - (use Unix sockets on
#                                                                           Unix/Linux)
#        Default:     "127.0.0.1;3306;acore;acore;acore_playerbots"       - (PlayerbotDatabaseInfo)

PlayerbotsDatabaseInfo = "127.0.0.1;3306;acore;acore;acore_playerbots"

#    PlayerbotsDatabase.WorkerThreads
#        Description: The amount of worker threads spawned to handle asynchronous (delayed) MySQL
#                     statements. Each worker thread is mirrored with its own connection to the
#                     MySQL server and their own thread on the MySQL server.
#        Default:     1 - (PlayerbotsDatabase.WorkerThreads)

PlayerbotsDatabase.WorkerThreads     = 1

#    PlayerbotsDatabase.SynchThreads
#        Description: The amount of MySQL connections spawned to handle.
#        Default:     1 - (PlayerbotDatabase.WorkerThreads)

PlayerbotsDatabase.SynchThreads     = 1

#    Playerbot.Updates.EnableDatabases
#        Description: Determined if updates system work with playerbots database.
#
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

Playerbots.Updates.EnableDatabases = 1

# Command server port, 0 - disabled
AiPlayerbot.CommandServerPort = 8888

#
#
####################################################################################################

####################################################################################################
# DEBUG SWITCHES
#

AiPlayerbot.SpellDump = 0
AiPlayerbot.LogInGroupOnly = 1
AiPlayerbot.LogValuesPerTick = 0
AiPlayerbot.RandomChangeMultiplier = 1

# Tell which spell is avoiding (experimental)
# Default: 0 (disabled)
AiPlayerbot.TellWhenAvoidAoe = 0

# Enable/Disable performance monitor
AiPlayerbot.PerfMonEnabled = 0

#
#
####################################################################################################

####################################################################################################
# CHAT SETTINGS
#

# Prefix for bot chat commands (e.g., follow, stay)
AiPlayerbot.CommandPrefix = ""

# Separator for bot chat commands
AiPlayerbot.CommandSeparator = "\\\\"

# Enable automatic item count/trade trigger when a chat message contains
# item-related keywords. When enabled (1), mentioning items in chat
# (e.g. "food", "potion", "ammo") will automatically show inventory and
# open a trade window with the bot. Explicit "c" and "t" commands still
# work regardless of this setting.
# Default: 1 (enabled)
AiPlayerbot.EnableAutoTradeOnItemMention = 1

# Enable bots talking (say / yell / general chatting / lfg)
AiPlayerbot.RandomBotTalk = 1
# Enable bots emoting
AiPlayerbot.RandomBotEmote = 0
# Chance (0-100) for a bot to respond to another bot's emote or keep up an
# emote conversation with another bot. Replies to real players are unaffected.
# Keeps bot-to-bot emote exchanges from looping forever (each reply rolls this
# chance, so chains die out quickly). 0 disables bot-to-bot emote replies.
AiPlayerbot.EmoteReplyChanceToBots = 30
# After one bot replies to another bot's emote, other bots stay silent toward
# that bot for this many seconds, so a single bot (occasionally two) responds
# instead of the whole crowd emoting back at once. 0 disables the window and
# lets every nearby bot roll EmoteReplyChanceToBots independently.
AiPlayerbot.EmoteReplyClaimSeconds = 10
# Chance (0-100) for a bot to actually emote or make a talk gesture when its
# unprompted emote timer fires (requires RandomBotEmote). At 100 a bot standing
# near others makes a talk gesture roughly every 15 seconds; lower this to
# thin out idle emote spam. Replies to received emotes are unaffected (see
# EmoteReplyChanceToBots).
AiPlayerbot.UnpromptedEmoteChance = 100
# Enable randombots suggesting dungeons in chat
AiPlayerbot.RandomBotSuggestDungeons = 1
# Bots greet players when invited
AiPlayerbot.EnableGreet = 0
# Chance to reply to toxic links with toxic links (0-100)
AiPlayerbot.ToxicLinksRepliesChance = 30
# Chance to reply to Thunderfury with Thunderfury (0-100)
AiPlayerbot.ThunderfuryRepliesChance = 40
# Enable bots chatting in guild about certain events
AIPlayerbot.GuildFeedback = 1
# Chance bots will chat in guild about certain events (int) (0-100)
AiPlayerbot.GuildRepliesRate = 100
# Bots without a master will say their lines
AiPlayerbot.RandomBotSayWithoutMaster = 0

# Bystander assist (Felworld): solo random bots rescue nearby non-group
# players (real players and bots) who look like they're about to die.
# Healer classes (priest/paladin/druid/shaman) heal the victim; other
# classes attack the creature attacking them. A bot never takes an
# assistive action that would newly PvP-flag it, and it skips fights it
# estimates as unwinnable by composition (an elite counts as roughly
# three normal mobs; world bosses and mobs far above the bot's level
# are never taken on). Players losing a PVP fight qualify too: healer
# classes support them with heals - never by attacking (joining the fight
# is the passerby-assist path above) - each supporter first passing the
# BystanderPvpSupportChance dice, and nobody heals into a dogpile of more
# than two player attackers. Once a rescue heal lands the healer stays on
# its victim through the combat it causes, until the victim is safe, out
# of range, or the healer itself is below its self-preservation gates.
AiPlayerbot.EnableBystanderAssist = 1
# Radius (yards) within which a bot notices someone in distress.
AiPlayerbot.BystanderAssistRadius = 40
# Chance (percent, deterministic per bot/victim pair) that a healer-class
# bystander supports a stranger losing a player fight. Etiquette suggests
# helping, but not every passerby commits to someone else's PvP.
AiPlayerbot.BystanderPvpSupportChance = 50
# A victim under attack counts as "in distress" when ANY of:
# - health below BystanderDistressHealth percent (healer-class victims
#   that still have mana use the stricter BystanderDistressHealerHealth),
# - a mana user's mana below BystanderDistressLowMana percent while
#   health is below BystanderDistressLowManaHealth percent,
# - they lost BystanderDistressRateHealthLoss percent of max health
#   within BystanderDistressRateWindow seconds,
# - at least BystanderDistressMobCount creatures are on them and they
#   have taken some damage.
AiPlayerbot.BystanderDistressHealth = 40
AiPlayerbot.BystanderDistressHealerHealth = 25
AiPlayerbot.BystanderDistressLowMana = 15
AiPlayerbot.BystanderDistressLowManaHealth = 60
AiPlayerbot.BystanderDistressRateHealthLoss = 20
AiPlayerbot.BystanderDistressRateWindow = 4
AiPlayerbot.BystanderDistressMobCount = 3
# Stand down when this many other players are already helping the victim.
AiPlayerbot.BystanderAssistMaxHelpers = 2
# Per-victim cooldown (seconds) after a bot assists, so it doesn't ping-pong.
AiPlayerbot.BystanderAssistCooldown = 30
# A bot only volunteers while its own health/mana are above these percents.
AiPlayerbot.BystanderAssistSelfHealth = 50
AiPlayerbot.BystanderAssistSelfMana = 30

# Social buffing (Felworld): idle ungrouped buff-capable bots (mage/priest/
# druid/paladin) cast their signature class buff on nearby friendly players
# who lack it, and any such bot buffs back whoever buffs it. A bot never
# buffs a PvP-flagged target unless it is already flagged itself.
AiPlayerbot.EnableSocialBuffing = 1
# Radius (yards) within which a bot offers walk-up buffs.
AiPlayerbot.SocialBuffRadius = 30
# Per-target cooldown (seconds) after buffing (or trying to), so a bot
# doesn't court the same stranger every scan.
AiPlayerbot.SocialBuffCooldown = 600
# Per-bot cooldown (seconds) between walk-up buffs, so a bot blesses at most
# one stranger per window instead of working through a whole crowd. Buffing
# back whoever buffed the bot is never blocked by this.
AiPlayerbot.SocialBuffGiverCooldown = 60
# A bot only volunteers buffs while its own mana is above this percent.
AiPlayerbot.SocialBuffSelfMana = 40
# Bots respond to a stranger's heal with a targeted /thank emote (the LLM
# module adds the spoken thanks).
AiPlayerbot.EnableHealThanks = 1
# Per-healer cooldown (seconds) between thank-yous.
AiPlayerbot.SocialThankCooldown = 180

# Quest competition groups (Felworld): a solo random bot that sees a nearby
# ungrouped same-faction real player (within 4 levels) fighting a
# creature the bot still needs for an in-progress quest silently invites
# them to a group, the way real players resolve spawn competition. While
# grouped the bot keeps grinding the shared objectives as a peer ("grind
# quests") instead of following. Mob types the bot fights that a member
# still needs join the shared-objective set, so the group survives moving
# to the next camp; once nobody in the group needs any of those mobs, the
# bot says thanks in party chat and leaves. Distant shared quests never
# hold the group together.
AiPlayerbot.QuestCompetitionInvite = 1
# Per-player cooldown (seconds) between invite attempts, shared across
# all bots: after any bot invites (or is declined by) a player, no bot
# invites them again until it expires, so invite volume doesn't scale
# with how many bots are nearby.
AiPlayerbot.QuestCompetitionInviteCooldown = 600
# How large the group is allowed to grow, counting the bot and the real
# player. Once the real player is in the group, the bot recruits other
# bots competing for the same spawns the same way it recruited them, and
# those bots grind and leave as peers. Party sizes only (2-5); 2 leaves
# no room, so the group stays the bot and the player.
AiPlayerbot.QuestCompetitionGroupSize = 5

# Stealth-spotting reactions (Felworld): when a bot's stealth detection
# genuinely reaches a stealthed player nearby (the core detection math -
# level and stealth/detect auras, up to 30 yards - but in all directions,
# since the client's detect ping isn't directional), it has the same "oh
# crap" moment a real player does: it freezes mid-stride, snaps around
# to face the stealther, and hesitates a beat before carrying on.
# Sometimes it follows up with an emote: a /wave at a friendly sneak
# (only when no enemy is nearby to take advantage), or a /point calling
# out a hostile one (only when a friendly is around to warn and the bot
# isn't PvP-flagged itself). Friend or enemy both startle; group members
# never do, and a bot that is itself stealthed stays quiet.
AiPlayerbot.EnableStealthReactions = 1
# Per-stealther cooldown (seconds), so one rogue circling a bot gets one
# reaction, not one per scan.
AiPlayerbot.StealthReactionCooldown = 180
# Percent chance the startle resolves into the follow-up emote.
AiPlayerbot.StealthReactionEmoteChance = 30
# Stealth flushing: a bot that loses sight of an enemy it knows went into
# hiding - a rogue Vanishing mid-fight, a duel opponent stealthing during
# the countdown, a spotted sneak slipping back out of detection range -
# remembers the last place it perceived them and tries to flush them out:
# it sweeps the spot, and classes with a tool use it (paladin
# Consecration, hunter Flare and a trap, mage Arcane Explosion, priest
# Holy Nova, death knight Death and Decay, shaman Magma Totem; druids
# instead tag a revealed rogue/druid with Faerie Fire so they can't
# restealth). Never used against someone directly targetable, and only
# against enemies the bot would fight anyway (truces and satiation are
# honored; duel opponents always count). Chance is rolled once per
# disappearance - the rest of the time the bot shrugs and moves on.
# 0 disables flushing (the startle reactions above are unaffected).
AiPlayerbot.StealthFlushChance = 70
# How long (seconds) the suspicion - and the search - lasts.
AiPlayerbot.StealthFlushSeconds = 15
# The rogue Distract opener trick: a stealthed rogue bot closing on a
# player who is facing it casts Distract past them, turning their back so
# it can walk straight in for the opener instead of circling wide. Percent
# of rogues that know the trick - rolled once per character, so a given
# rogue is consistently tricky or consistently not. Tricky rogues still
# pick their moments: only at full energy, only against targets that con
# yellow or above, and never against a defender with area damage or
# detection already down (Consecration, Death and Decay, a flare, an
# armed trap, a fire totem) - they'd sweep the approach no matter which
# way they face. 0 disables the trick entirely.
AiPlayerbot.RogueDistractChance = 60
# The counter: a bot that gets Distracted may read the forced turn for
# exactly what it is. Percent chance - rolled per incident, so even a
# sharp defender sometimes falls for it - that after a human-scale beat
# (1-2.5s) the bot breaks the facing lock, spins around, and treats the
# opposite lane as a stealth suspicion for the flush machinery above
# (StealthFlushChance and StealthFlushSeconds apply as usual). The bot
# never learns who threw it - everything derives from its own forced
# facing. A failed roll stares at the noise for the full duration.
# 0 disables the counter (Distract then always works).
AiPlayerbot.DistractSuspicionChance = 60

# Human reaction latency (Felworld): triggers that model twitch reactions -
# interrupts, dispels/decurses (including Hand of Freedom on a rooted ally),
# emergency heals - fire after a jittered per-event delay instead of on the
# first AI tick, so bots stop reacting superhumanly fast and metronomically.
# Each event samples a delay uniformly from [Min, Max] milliseconds; each
# ally or enemy cast gets its own roll, so a second victim never inherits
# the first one's elapsed delay. MissChance (percent) makes the bot instead
# wait out the full Max window and then roll again if the situation still
# holds: short enemy casts simply get away, while a still-rooted or dying
# ally is eventually noticed late. Set a Max to 0 to disable that category.
AiPlayerbot.ReactionDelayInterruptMin = 200
AiPlayerbot.ReactionDelayInterruptMax = 1500
AiPlayerbot.ReactionMissChanceInterrupt = 5
AiPlayerbot.ReactionDelayDispelMin = 400
AiPlayerbot.ReactionDelayDispelMax = 2500
AiPlayerbot.ReactionMissChanceDispel = 5
AiPlayerbot.ReactionDelayEmergencyHealMin = 300
AiPlayerbot.ReactionDelayEmergencyHealMax = 2000
AiPlayerbot.ReactionMissChanceEmergencyHeal = 5

#
#
####################################################################################################

####################################################################################################
# Broadcast rates
#

# Enable/disable broadcasts globally
# Default: 1 (enabled)
AiPlayerbot.EnableBroadcasts = 1

# All broadcast chances should be in range 0-30000
# Value of 0 will disable this particular broadcast
# Setting value to 30000 does not guarantee the broadcast, as there are some internal randoms as well
# Setting channel broadcast chance to 0 will re-route most broadcasts to other available channels
# Setting all channel broadcasts to 0 will disable most broadcasts
AiPlayerbot.BroadcastToGuildGlobalChance = 30000
AiPlayerbot.BroadcastToWorldGlobalChance = 30000
AiPlayerbot.BroadcastToGeneralGlobalChance = 30000
AiPlayerbot.BroadcastToTradeGlobalChance = 30000
AiPlayerbot.BroadcastToLFGGlobalChance = 30000
AiPlayerbot.BroadcastToLocalDefenseGlobalChance = 30000
AiPlayerbot.BroadcastToWorldDefenseGlobalChance = 30000
AiPlayerbot.BroadcastToGuildRecruitmentGlobalChance = 30000

# Individual settings
# Setting one of these to 0 will disable the particular broadcast
AiPlayerbot.BroadcastChanceLootingItemPoor = 30
AiPlayerbot.BroadcastChanceLootingItemNormal = 150
AiPlayerbot.BroadcastChanceLootingItemUncommon = 10000
AiPlayerbot.BroadcastChanceLootingItemRare = 20000
AiPlayerbot.BroadcastChanceLootingItemEpic = 30000
AiPlayerbot.BroadcastChanceLootingItemLegendary = 30000
AiPlayerbot.BroadcastChanceLootingItemArtifact = 30000

AiPlayerbot.BroadcastChanceQuestAccepted = 6000
AiPlayerbot.BroadcastChanceQuestUpdateObjectiveCompleted = 300
AiPlayerbot.BroadcastChanceQuestUpdateObjectiveProgress = 300
AiPlayerbot.BroadcastChanceQuestUpdateFailedTimer = 300
AiPlayerbot.BroadcastChanceQuestUpdateComplete = 1000
AiPlayerbot.BroadcastChanceQuestTurnedIn = 10000

AiPlayerbot.BroadcastChanceKillNormal = 30
AiPlayerbot.BroadcastChanceKillElite = 300
AiPlayerbot.BroadcastChanceKillRareelite = 3000
AiPlayerbot.BroadcastChanceKillWorldboss = 20000
AiPlayerbot.BroadcastChanceKillRare = 10000
AiPlayerbot.BroadcastChanceKillUnknown = 100
AiPlayerbot.BroadcastChanceKillPet = 10
AiPlayerbot.BroadcastChanceKillPlayer = 30

AiPlayerbot.BroadcastChanceLevelupGeneric = 20000
AiPlayerbot.BroadcastChanceLevelupTenX = 30000
AiPlayerbot.BroadcastChanceLevelupMaxLevel = 30000

AiPlayerbot.BroadcastChanceSuggestInstance = 5000
AiPlayerbot.BroadcastChanceSuggestQuest = 10000
AiPlayerbot.BroadcastChanceSuggestGrindMaterials = 5000
AiPlayerbot.BroadcastChanceSuggestGrindReputation = 5000
AiPlayerbot.BroadcastChanceSuggestSell = 300
